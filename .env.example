# Copy this file to .env in the project root (git-ignored). The framework reads .env automatically,
# so local runs work from Eclipse (TestNG or Maven), IntelliJ or the command line with no extra setup.
# Real environment variables still take priority over .env.
# In CI these come from repository/pipeline secrets - they are never committed.
#
# The values below are the PUBLISHED demo credentials of the public practice sites
# (shown on the SauceDemo login page and in the Restful Booker docs). For a real
# application these would be real secrets and this file would hold placeholders only.

# Password shared by the SauceDemo demo users (standard_user, locked_out_user, problem_user)
UI_USER_PASSWORD=secret_sauce

# Restful Booker admin account used to create an auth token
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=password123
